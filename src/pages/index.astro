---
import Base from '../layouts/Base.astro';
import Container from '../components/Container.astro';
import Icon from '../components/Icon.astro';
import { site, socials } from '../lib/site';

// Home and About are one page. There is not enough to say to justify two.
---

<Base>
  <Container class="mt-16 sm:mt-32">
    <div class="grid grid-cols-1 gap-y-16 lg:grid-cols-2 lg:grid-rows-[auto_1fr] lg:gap-y-12">
      <div class="lg:pl-20">
        <div class="max-w-xs px-2.5 lg:max-w-none">
          <img
            src="/images/reed.jpg"
            alt="Reed Dadoune"
            width="1000"
            height="1000"
            class="aspect-square rotate-3 rounded-2xl bg-zinc-100 object-cover dark:bg-zinc-800"
          />
        </div>
      </div>

      <div class="lg:order-first lg:row-span-2">
        <h1 class="text-4xl font-bold tracking-tight text-zinc-800 sm:text-5xl dark:text-zinc-100">
          I&rsquo;m Reed, a software engineer.
        </h1>
        <div class="mt-6 space-y-7 text-base text-zinc-600 dark:text-zinc-400">
          <p>
            I&rsquo;ve been tinkering with software since I was young and never really stopped.
            Most of my career has been on the web, though a good part of it has been the layers
            underneath: data pipelines, infrastructure, and a long stretch of native mobile.
            These days I&rsquo;m at Spokeo, where I&rsquo;ve never had the same job twice.
          </p>
        </div>
      </div>

      <div class="lg:pl-20">
        <ul role="list">
          {
            socials
              .filter((s) => s.icon !== 'mail')
              .map((s, i) => (
                <li class:list={['flex', i > 0 && 'mt-4']}>
                  <a
                    href={s.href}
                    class="group flex text-sm font-medium text-zinc-800 transition hover:text-teal-500 dark:text-zinc-200 dark:hover:text-teal-500"
                  >
                    <Icon
                      name={s.icon}
                      class="h-6 w-6 flex-none fill-zinc-500 transition group-hover:fill-teal-500"
                    />
                    <span class="ml-4">{s.label}</span>
                  </a>
                </li>
              ))
          }
          <li class="mt-8 flex border-t border-zinc-100 pt-8 dark:border-zinc-700/40">
            <a
              href={`mailto:${site.email}`}
              class="group flex text-sm font-medium text-zinc-800 transition hover:text-teal-500 dark:text-zinc-200 dark:hover:text-teal-500"
            >
              <Icon
                name="mail"
                class="h-6 w-6 flex-none fill-zinc-500 transition group-hover:fill-teal-500"
              />
              <span class="ml-4">{site.email}</span>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </Container>
</Base>
