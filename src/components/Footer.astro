---
import Container from './Container.astro';
import { nav, site } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="mt-32 flex-none">
  <Container variant="outer">
    <div class="border-t border-zinc-100 pt-10 pb-16 dark:border-zinc-700/40">
      <Container variant="inner">
        <div class="flex flex-col items-center justify-between gap-6 md:flex-row">
          <div class="flex flex-wrap justify-center gap-x-6 gap-y-1 text-sm font-medium text-zinc-800 dark:text-zinc-200">
            {
              nav.map((item) => (
                <a href={item.href} class="transition hover:text-teal-500 dark:hover:text-teal-400">
                  {item.label}
                </a>
              ))
            }
            <a href="/rss.xml" class="transition hover:text-teal-500 dark:hover:text-teal-400">RSS</a>
          </div>
          <p class="text-sm text-zinc-400 dark:text-zinc-500">
            &copy; 2012&ndash;{year} {site.name}. <a
              href={site.repo}
              class="transition hover:text-teal-500 dark:hover:text-teal-400">Open source on GitHub.</a
            >
          </p>
        </div>
      </Container>
    </div>
  </Container>
</footer>
